      "$asset_id": {
        ".read": "auth != null",
        ".write": "auth != null",
        "activity_logs": {
          ".read": "auth != null",
          ".write": "auth != null"
        }
      }
    },
    "clients": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "workers": {
      ".read": "auth != null",
      ".write": "auth != null"
    }
  }
}
